{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/privacy/:path*",
      "destination": "https://climpick.com/privacy",
      "statusCode": 301
    },
    {
      "source": "/(.*)",
      "destination": "https://climpick.com/",
      "statusCode": 301
    }
  ]
}
